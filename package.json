{
  "name": "hono-dp",
  "version": "1.0.0",
  "description": "Distrito Paulista RP — Portal Oficial & Dashboard SaaS Staff no Cloudflare Edge com Hono",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute hono-dp-db --local --file=./migrations/0000_initial_schema.sql",
    "db:seed:local": "wrangler d1 execute hono-dp-db --local --file=./migrations/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.5",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
